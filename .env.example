# Resend API Key (from https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Recipient email for contact and strategy call bookings
CONTACT_TO_EMAIL=robert@relaunch.us

# Sender email (requires domain verification in Resend)
CONTACT_FROM_EMAIL=ReLaunch Website <website@relaunch.us>

# Port (set automatically by hosting / Plesk)
PORT=3000
