# Copy to .env and fill in. All optional except PORT (has a default).
PORT=3001
LEAD_EMAIL=care@relaunch.us

# SMTP for lead notifications (IONOS mail). Leave blank to skip email — leads still log to leads.csv
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=care@relaunch.us
SMTP_PASS=your-mailbox-password
SMTP_FROM=ReLaunch Audit <no-reply@relaunch.us>
